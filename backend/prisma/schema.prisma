// Shirinliklar (konditerlik) buyurtma boti uchun ALOHIDA ma'lumotlar bazasi.
// Bu "Laylo milliy taomlari" (pizza-delivery) yoki "Zet Market" loyihalarining
// bazasi bilan HECH QANDAY aloqasi yo'q — butunlay mustaqil Neon Postgres
// bazasiga ulanadi (DATABASE_URL orqali, .env / Render Environment'da alohida).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Bitta qatordan iborat umumiy sozlamalar (id doim 1) — masalan bot va
// Mini App'ning boshlang'ich (start) logosi, admin panel orqali o'zgartiriladi.
model Settings {
  id         Int      @id @default(1)
  startImage String? // bot /start xabari va Mini App bosh sahifasidagi logo
  updatedAt  DateTime @updatedAt
}

model Category {
  id        Int       @id @default(autoincrement())
  emoji     String // masalan "🍰" — rasm bo'lmaganda zaxira (fallback) sifatida ishlatiladi
  image     String? // admin panel orqali yuklanadigan kategoriya rasmi (ImgBB havolasi)
  nameUz    String
  nameRu    String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  nameUz      String
  nameRu      String
  descriptionUz String?
  descriptionRu String?
  ingredientsUz String? // tarkibi
  ingredientsRu String?
  weight      String? // og'irligi/porsiyasi, masalan "500 g" — erkin matn
  price       Int // so'mda
  oldPrice    Int?
  imageUrl    String?
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  favorites   Favorite[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id          Int       @id @default(autoincrement())
  telegramId  String    @unique
  firstName   String?
  lastName    String?
  username    String?
  phone       String?
  languageCode String   @default("uz") // "uz" | "ru" — mijoz tanlagan til
  orders      Order[]
  favorites   Favorite[]
  addresses   SavedAddress[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model SavedAddress {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  label     String? // masalan "Uy", "Ish"
  address   String
  location  String? // "lat,lng" (Telegram location yuborilsa)
  createdAt DateTime @default(now())
}

model PromoCode {
  id               Int       @id @default(autoincrement())
  code             String    @unique
  percentOff       Int? // foizli chegirma (0-100)
  amountOff        Int? // summaviy chegirma (so'mda)
  minOrderAmount   Int       @default(0)
  expiresAt        DateTime?
  isActive         Boolean   @default(true)
  usageCount       Int       @default(0)
  orders           Order[]
  createdAt        DateTime  @default(now())
}

// Buyurtma holatlari — spetsifikatsiyadagi 7 bosqich
enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  DELIVERING
  DELIVERED
  CANCELLED
}

model Order {
  id                  Int         @id @default(autoincrement())
  userId              Int
  user                User        @relation(fields: [userId], references: [id])
  status              OrderStatus @default(NEW)

  // Oddiy mahsulot buyurtmasi uchun — savatdagi mahsulotlar shu yerda JSON
  // sifatida "suratga olinadi" (narx/nom o'zgarib ketsa ham buyurtma tarixi
  // buzilmasin uchun) — xuddi pizza-delivery loyihasidagi kabi.
  items               Json? // [{productId, name, price, qty, imageUrl}]

  // Maxsus tort buyurtmasi bo'lsa shu maydonlar to'ldiriladi, items bo'sh qoladi
  isCustomCake        Boolean     @default(false)
  cakeType             String?
  cakeSize             String?
  cakeFlavor           String?
  cakeDesign           String?
  cakeText             String? // tort ustidagi yozuv
  cakeNote             String? // qo'shimcha izoh
  cakeImageUrl         String? // mijoz yuborgan namuna rasmi
  cakePrice            Int?        // admin narx belgilagach to'ldiriladi (dastlab null — "narxlanmoqda")

  subtotal            Int         @default(0) // mahsulotlar/tort narxi yig'indisi
  deliveryPrice        Int         @default(0)
  discount             Int         @default(0)
  totalPrice           Int         @default(0)

  promoCodeId          Int?
  promoCode            PromoCode?  @relation(fields: [promoCodeId], references: [id])

  deliveryAddress      String?
  deliveryLocation      String? // "lat,lng"
  deliveryDate          String? // "2026-09-20"
  deliveryTime           String? // "14:00"
  phone                String?
  note                 String?

  paymentMethod        String      @default("cash") // cash | click | payme
  paymentStatus        String      @default("pending") // pending | paid | failed
  paymentProviderData  Json?

  createdAt            DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([status])
  @@index([userId])
}

// Click/Payme merchant kalitlari qo'shilgunga qadar bu jadval bo'sh turadi —
// pizza-delivery loyihasidagi PaymeTransaction bilan bir xil mantiq, lekin
// bu ALOHIDA baza, shu sabab alohida jadval.
model PaymeTransaction {
  id         String   @id
  orderId    Int
  amount     Int
  state      Int
  reason     Int?
  createTime BigInt
  performTime BigInt?
  cancelTime  BigInt?
  createdAt  DateTime @default(now())
}
